# ─────────────────────────────────────────────────────────────
# SERMEKARE · variables de entorno (copia este archivo a .env.local)
# Todas son SOLO de servidor: nunca les pongas el prefijo NEXT_PUBLIC_.
# Sin ninguna variable, la web funciona completa en MODO DEMO.
# Guía paso a paso: docs/CONFIGURAR-CITAS.md
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (se usa en metadatos y enlaces absolutos).
NEXT_PUBLIC_SITE_URL=https://sermekare.com

# Proveedor de citas: "demo" (por defecto) o "calcom".
BOOKING_PROVIDER=demo

# Cal.com API v2 (Settings → Developer → API keys). Empieza con cal_live_ en producción.
CALCOM_API_KEY=
# Opcionales (valores por defecto entre paréntesis).
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_WEB_URL=https://cal.com

# Secreto del webhook de Cal.com (el mismo que escribes al crear el webhook).
CALCOM_WEBHOOK_SECRET=

# WhatsApp Cloud API (opcional): confirmación automática con una plantilla aprobada por Meta.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=confirmacion_cita
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_GRAPH_VERSION=v21.0
