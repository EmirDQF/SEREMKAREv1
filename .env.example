# ─────────────────────────────────────────────────────────────
# SERMEKARE · variables de entorno
# En Hostinger: cárgalas en el panel de la aplicación Node.js (Variables de entorno).
# En tu PC: copia este archivo a .env.local. Nunca subas archivos .env con valores reales.
#
# Solo NEXT_PUBLIC_SITE_URL es obligatoria. Sin las de Cal.com y WhatsApp Cloud, la web funciona
# completa: las citas se coordinan en modo demostración y por WhatsApp.
# No pongas el prefijo NEXT_PUBLIC_ a ningún secreto (se vería en el navegador).
# Guía de citas en línea: docs/CONFIGURAR-CITAS.md
# ─────────────────────────────────────────────────────────────

# OBLIGATORIA. URL pública del sitio, sin barra final. Se usa en canonical, sitemap, Open Graph y
# JSON-LD. Se fija al compilar: si la cambias, vuelve a compilar.
NEXT_PUBLIC_SITE_URL=https://sermekare.com

# OPCIONAL. Proveedor de citas: "demo" (por defecto si se deja vacía) o "calcom".
BOOKING_PROVIDER=demo

# OPCIONAL (obligatoria solo con BOOKING_PROVIDER=calcom). API key de Cal.com v2
# (Settings → Developer → API keys). En producción empieza con cal_live_.
CALCOM_API_KEY=
# OPCIONALES. Direcciones de Cal.com; déjalas así salvo que uses otra instancia.
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_WEB_URL=https://cal.com

# OPCIONAL (obligatoria solo con BOOKING_PROVIDER=calcom). Secreto del webhook de Cal.com: el mismo
# que escribes al crear el webhook.
CALCOM_WEBHOOK_SECRET=

# OPCIONALES. WhatsApp Cloud API: confirmación automática de citas con una plantilla aprobada por Meta.
# Sin ellas, la confirmación se hace por el enlace de WhatsApp de siempre.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=confirmacion_cita
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_GRAPH_VERSION=v21.0

# SERVIDOR: PORT la define Hostinger; no la cambies. El paquete compilado (node server.js) escucha
# siempre en todas las interfaces (0.0.0.0): no hace falta definir HOSTNAME.
# PORT=3000
